{
  "presets": [
    "git",
    "github"
  ],
  "validators": {
    "jsonlint": {
      "cmd": "{python} {supertool_dir}/validators/jsonlint/jsonlint.py {file}",
      "match": "*.json",
      "hooks_into": [
        "edit",
        "replace",
        "replace_lines",
        "paste",
        "append",
        "vim"
      ],
      "rollback_on_fail": true,
      "timeout": 10
    },
    "yaml-check": {
      "cmd": "{python} {supertool_dir}/validators/yaml-check/yaml-check.py {file}",
      "match": "*.yml",
      "hooks_into": [
        "edit",
        "replace",
        "replace_lines",
        "paste",
        "append",
        "vim"
      ],
      "rollback_on_fail": true,
      "timeout": 10
    }
  }
}
